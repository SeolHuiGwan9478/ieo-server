# 로컬 실행용 환경변수. 이 파일을 .env로 복사해서 값을 채운다 (.env는 커밋되지 않는다)
# Spring이 local 프로필에서 .env를 읽는다 (application-local.yml의 spring.config.import)

# 로컬 PostgreSQL + PostGIS. 처음 한 번: createdb ieo, CREATE EXTENSION postgis
DB_URL=jdbc:postgresql://localhost:5432/ieo
# macOS는 보통 OS 계정 이름·비밀번호 없음. Windows 설치판은 postgres 계정과 설치 때 정한 비밀번호
DB_USERNAME=postgres
DB_PASSWORD=

# 오피넷 유가정보 API 키 (무료, 하루 300건). 비우면 경유가를 설정값으로 계산한다
OPINET_API_KEY=

# 포트가 겹치면 여기서 바꾼다 (기본 8080, 콘솔 CORS 기본 5173)
# server.port=8081
# ieo.cors.allowed-origins=http://localhost:5174
