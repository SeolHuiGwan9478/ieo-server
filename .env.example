# 로컬 실행용 환경변수. 이 파일을 .env로 복사해서 값을 채운다 (.env는 커밋되지 않는다)
# Spring이 local 프로필에서 .env를 읽는다 (application-local.yml의 spring.config.import)

# 로컬 PostgreSQL + PostGIS. 처음 한 번: createdb ieo, CREATE EXTENSION postgis
DB_URL=jdbc:postgresql://localhost:5432/ieo
# macOS는 보통 OS 계정 이름·비밀번호 없음. Windows 설치판은 postgres 계정과 설치 때 정한 비밀번호
DB_USERNAME=postgres
DB_PASSWORD=

# 오피넷 유가정보 API 키 (무료, 하루 300건). 비우면 경유가를 설정값으로 계산한다
OPINET_API_KEY=
# TMAP 화물차 경로 (거리·통행료). 비우면 직선거리 어림으로 계산한다
TMAP_APP_KEY=

# 음성 대답 판별 (UX-025). OpenRouter 키와 모델 이름. 비우면 서버 판별 없이 차량 앱의 단어 목록만 쓴다
# 추천: typesafe/jev-1.14 (분류 모델, 결정 API로 부른다. 확신 기준 0.7을 맞춘 버전이라 고정). 다른 채팅 모델 이름을 넣으면 채팅 API로 부른다
OPENROUTER_API_KEY=
OPENROUTER_MODEL=typesafe/jev-1.14

# 국세청 사업자등록 진위확인 키 (무료). 공공데이터포털에서 "국세청_사업자등록정보 진위확인 및 상태조회 서비스"(data.go.kr/data/15081808)를
# 활용신청하면 바로 승인된다. "일반 인증키 (Decoding)" 값을 넣는다. 비우면 사업자등록증을 조회하지 않고 운영자가 눈으로만 본다
NTS_SERVICE_KEY=
# 키 없이 시연할 때 가짜 결과를 쓴다 (scripts/seed-documents.py 의 시연 차주가 이 규칙으로 번호를 받는다). 운영에서는 넣지 않는다
# NTS_STUB=true

# 포트가 겹치면 여기서 바꾼다 (기본 8080, 콘솔 CORS 기본 5173)
# server.port=8081
# ieo.cors.allowed-origins=http://localhost:5174

# 소셜 로그인 (주선사 콘솔). 비우면 그 공급자는 "준비 중"으로 보인다
# Google Cloud 콘솔 > OAuth 클라이언트 ID (웹). 콘솔(ieo-web)의 VITE_GOOGLE_CLIENT_ID와 같은 값
GOOGLE_CLIENT_ID=
# 주소 좌표 조회와 소셜 로그인 공용. 카카오 디벨로퍼스 > 앱 키 > REST API 키. 콘솔은 JavaScript 키(VITE_KAKAO_JS_KEY)를 쓴다
KAKAO_REST_API_KEY=
# 카카오 "보안 > Client Secret"을 켰을 때만
KAKAO_CLIENT_SECRET=

# 휴대폰 푸시 (FCM). Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키. 파일 경로나 JSON 내용. 비어 있으면 푸시는 보내지 않는다
# 키 파일은 저장소 밖(예: ~/.ieo/firebase-admin.json)에 두고 커밋하지 않는다
FIREBASE_CREDENTIALS=
